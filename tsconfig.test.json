{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["vitest/globals", "node"],
		"paths": {
			"obsidian": ["../test/__mocks__/obsidian.ts"]
		}
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts"
	]
}
