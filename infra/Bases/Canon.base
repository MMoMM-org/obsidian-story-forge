filters: file.inFolder("30 Canon")
properties:
  file.name:
    displayName: Name
  role:
    displayName: Role
  status:
    displayName: Status
  age:
    displayName: Age
  occupation:
    displayName: Occupation
  tagline:
    displayName: Tagline
  locationType:
    displayName: Type
  region:
    displayName: Region
  inhabitants:
    displayName: Inhabitants
  kind:
    displayName: Kind
  owner:
    displayName: Owner
  scope:
    displayName: Scope
  related:
    displayName: Related
views:
  - type: table
    name: Characters
    filters: file.hasTag("canon/character")
    groupBy:
      property: role
      direction: ASC
    order:
      - file.name
      - role
      - status
      - age
      - occupation
      - tagline
  - type: cards
    name: Characters (cards)
    filters: file.hasTag("canon/character")
    order:
      - file.name
      - portrait
      - tagline
  - type: table
    name: Locations
    filters: file.hasTag("canon/location")
    order:
      - file.name
      - locationType
      - region
      - inhabitants
  - type: table
    name: Objects
    filters: file.hasTag("canon/object")
    order:
      - file.name
      - kind
      - owner
  - type: table
    name: Lore
    filters: file.hasTag("canon/lore")
    order:
      - file.name
      - scope
      - related
