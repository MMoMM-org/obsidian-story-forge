{
	"name": "story-forge",
	"version": "0.2.0",
	"description": "Shows your story's entities from frontmatter: browse and edit them in the Anvil, and see the ones linked from the active note in the Workbench.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"predev": "npm run catalog:build && npm run artifacts:build",
		"dev": "node esbuild.config.mjs",
		"catalog:build": "node scripts/build-catalog.mjs",
		"artifacts:build": "node scripts/build-artifacts.mjs",
		"build": "npm run catalog:build && npm run artifacts:build && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"typecheck:test": "tsc --noEmit -p tsconfig.test.json",
		"typecheck:mock": "tsc -p tsconfig.test.json --emitDeclarationOnly --declaration --noEmit false --outDir .typecheck-mock-tmp && tsc --noEmit -p tsconfig.mock.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:live": "vitest run --config vitest.live.config.ts",
		"schema:gen": "node scripts/schema-gen.mjs",
		"schema:check": "node scripts/schema-check.mjs",
		"lint": "eslint . && stylelint styles.css",
		"lint:css": "stylelint styles.css",
		"lint:fix": "eslint . --fix && stylelint styles.css --fix",
		"audit": "npm audit --audit-level=high --omit=dev"
	},
	"keywords": [],
	"license": "MIT",
	"browserslist": [
		"chrome 114"
	],
	"devDependencies": {
		"@eslint/js": "9.39.4",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/exec": "7.1.0",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "12.0.11",
		"@types/node": "^22.0.0",
		"esbuild": "0.25.5",
		"eslint": "9.39.4",
		"eslint-plugin-obsidianmd": "0.6.0",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"jsdom": "^26.1.0",
		"semantic-release": "25.0.9",
		"stylelint": "^16.0.0",
		"stylelint-no-unsupported-browser-features": "^8.0.0",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.73.0",
		"vitest": "4.1.12",
		"yaml": "^2.9.0"
	},
	"peerDependencies": {
		"obsidian": ">=1.5.7"
	},
	"overrides": {
		"moment": "^2.31.0",
		"eslint-plugin-n": {
			"minimatch": "^11.0.9"
		},
		"vite": "7.3.8"
	}
}
